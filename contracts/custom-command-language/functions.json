{
  "schemaVersion": 1,
  "languageVersion": "1.3.0",
  "caseSensitive": true,
  "callSyntax": "Identifier(arguments)",
  "userWritesAwait": false,
  "categories": {
    "reference": "Crea una referencia controlada a partir de un identificador.",
    "query": "Obtiene un valor controlado para utilizar dentro del programa.",
    "action": "Representa una acción disponible en el lenguaje."
  },
  "requirements": {
    "mention": "El comando exige que el mensaje mencione al menos a un miembro."
  },
  "functions": {
    "Channel": {
      "kind": "reference",
      "description": "Crea una referencia de canal a partir de un ID de Discord.",
      "parameters": [
        { "name": "channelId", "type": "String", "required": true, "format": "snowflake" }
      ],
      "returns": { "type": "ChannelReference", "nullable": false, "readOnly": true },
      "signatures": ["Channel(channelId: String): ChannelReference"],
      "examples": ["Channel(\"123456789012345678\")"]
    },
    "Role": {
      "kind": "reference",
      "description": "Crea una referencia de rol a partir de un ID de Discord.",
      "parameters": [
        { "name": "roleId", "type": "String", "required": true, "format": "snowflake" }
      ],
      "returns": { "type": "RoleReference", "nullable": false, "readOnly": true },
      "signatures": ["Role(roleId: String): RoleReference"],
      "examples": ["Role(\"371826690424569866\")"]
    },
    "GetMember": {
      "kind": "query",
      "description": "Obtiene un miembro mediante su ID. Puede devolver null.",
      "parameters": [
        { "name": "userId", "type": "String", "required": true, "format": "snowflake" }
      ],
      "returns": { "type": "Member", "nullable": true, "readOnly": true },
      "signatures": ["GetMember(userId: String): Member | Null"],
      "examples": [
        "const member = GetMember(\"123456789012345678\")",
        "const member = GetMember(\"123456789012345678\")\nif (member !== null) {\n    ReplyMessage({ message: member.displayName })\n}"
      ]
    },
    "GetMembers": {
      "kind": "query",
      "description": "Obtiene una colección de miembros disponibles.",
      "parameters": [],
      "returns": { "type": "Array<Member>", "nullable": false, "readOnly": true },
      "signatures": ["GetMembers(): Array<Member>"],
      "examples": ["const members = GetMembers()"]
    },
    "GetAuthor": {
      "kind": "query",
      "description": "Obtiene el miembro que escribió el mensaje que activó el comando.",
      "parameters": [],
      "returns": { "type": "Member", "nullable": false, "readOnly": true },
      "signatures": ["GetAuthor(): Member"],
      "examples": ["const author = GetAuthor()", "AddRole(GetAuthor(), Role(\"371826690424569866\"))"]
    },
    "GetMentionedMember": {
      "kind": "query",
      "description": "Obtiene el primer miembro mencionado en el mensaje, según el orden del texto. Ignora menciones de roles, @everyone, @here y usuarios que no pertenecen al servidor. El comando exige una mención: si el mensaje no menciona a ningún miembro, no se ejecuta.",
      "parameters": [],
      "returns": { "type": "Member", "nullable": false, "readOnly": true },
      "requires": ["mention"],
      "signatures": ["GetMentionedMember(): Member"],
      "examples": [
        "const target = GetMentionedMember()",
        "AddRole(GetMentionedMember(), Role(\"371826690424569866\"))"
      ]
    },
    "GetMentionedMembers": {
      "kind": "query",
      "description": "Obtiene todos los miembros mencionados en el orden del texto, sin duplicados. Ignora menciones de roles, @everyone, @here y usuarios que no pertenecen al servidor. El comando exige una mención: si el mensaje no menciona a ningún miembro, no se ejecuta, por lo que el array nunca está vacío.",
      "parameters": [],
      "returns": { "type": "Array<Member>", "nullable": false, "readOnly": true },
      "requires": ["mention"],
      "signatures": ["GetMentionedMembers(): Array<Member>"],
      "examples": [
        "const members = GetMentionedMembers()",
        "for (const member of GetMentionedMembers()) {\n    AddRole(member, Role(\"371826690424569866\"))\n}"
      ]
    },
    "random": {
      "kind": "query",
      "description": "Genera un número aleatorio decimal, mayor o igual que 0 y menor que 1.",
      "parameters": [],
      "returns": { "type": "Number", "nullable": false, "readOnly": true },
      "signatures": ["random(): Number"],
      "examples": ["const chance = random()"]
    },
    "randomRange": {
      "kind": "query",
      "description": "Genera un entero aleatorio entre min y max, ambos incluidos. Los dos tienen que ser enteros y min no puede ser mayor que max.",
      "parameters": [
        { "name": "min", "type": "Number", "required": true },
        { "name": "max", "type": "Number", "required": true }
      ],
      "returns": { "type": "Number", "nullable": false, "readOnly": true },
      "signatures": ["randomRange(min: Number, max: Number): Number"],
      "examples": ["const dado = randomRange(1, 6)"]
    },
    "choose": {
      "kind": "query",
      "description": "Elige al azar un elemento de una lista. La lista no puede estar vacía; devuelve un valor del mismo tipo que sus elementos.",
      "parameters": [
        { "name": "values", "type": "Array<Any>", "required": true }
      ],
      "returns": { "type": "Any", "nullable": false, "readOnly": true, "elementTypeOfParameter": 0 },
      "signatures": ["choose(values: Array<T>): T"],
      "examples": ["const respuesta = choose([\"Sí\", \"No\", \"Tal vez\"])"]
    },
    "now": {
      "kind": "query",
      "description": "Obtiene el momento actual como timestamp en milisegundos.",
      "parameters": [],
      "returns": { "type": "Number", "nullable": false, "readOnly": true },
      "signatures": ["now(): Number"],
      "examples": ["const inicio = now()"]
    },
    "date": {
      "kind": "query",
      "description": "Obtiene la fecha actual en UTC con formato AAAA-MM-DD.",
      "parameters": [],
      "returns": { "type": "String", "nullable": false, "readOnly": true },
      "signatures": ["date(): String"],
      "examples": ["const hoy = date()"]
    },
    "time": {
      "kind": "query",
      "description": "Obtiene la hora actual en UTC con formato HH:mm:ss.",
      "parameters": [],
      "returns": { "type": "String", "nullable": false, "readOnly": true },
      "signatures": ["time(): String"],
      "examples": ["const hora = time()"]
    },
    "username": {
      "kind": "query",
      "description": "Obtiene el nombre de usuario de quien escribió el comando.",
      "parameters": [],
      "returns": { "type": "String", "nullable": false, "readOnly": true },
      "signatures": ["username(): String"],
      "examples": ["ReplyMessage({ message: \"Hola, \" + username() })"]
    },
    "displayName": {
      "kind": "query",
      "description": "Obtiene el nombre visible en el servidor de quien escribió el comando. Si no tiene, usa su nombre de usuario.",
      "parameters": [],
      "returns": { "type": "String", "nullable": false, "readOnly": true },
      "signatures": ["displayName(): String"],
      "examples": ["ReplyMessage({ message: \"Hola, \" + displayName() })"]
    },
    "userId": {
      "kind": "query",
      "description": "Obtiene el ID de quien escribió el comando.",
      "parameters": [],
      "returns": { "type": "String", "nullable": false, "readOnly": true },
      "signatures": ["userId(): String"],
      "examples": ["const id = userId()"]
    },
    "channelId": {
      "kind": "query",
      "description": "Obtiene el ID del canal donde se escribió el comando.",
      "parameters": [],
      "returns": { "type": "String", "nullable": false, "readOnly": true },
      "signatures": ["channelId(): String"],
      "examples": ["const canal = Channel(channelId())"]
    },
    "serverId": {
      "kind": "query",
      "description": "Obtiene el ID del servidor.",
      "parameters": [],
      "returns": { "type": "String", "nullable": false, "readOnly": true },
      "signatures": ["serverId(): String"],
      "examples": ["const servidor = serverId()"]
    },
    "memberCount": {
      "kind": "query",
      "description": "Obtiene la cantidad de miembros del servidor.",
      "parameters": [],
      "returns": { "type": "Number", "nullable": false, "readOnly": true },
      "signatures": ["memberCount(): Number"],
      "examples": ["const miembros = memberCount()"]
    },
    "upper": {
      "kind": "query",
      "description": "Convierte un texto a mayúsculas.",
      "parameters": [
        { "name": "value", "type": "String", "required": true }
      ],
      "returns": { "type": "String", "nullable": false, "readOnly": true },
      "signatures": ["upper(value: String): String"],
      "examples": ["upper(\"hola\")"]
    },
    "lower": {
      "kind": "query",
      "description": "Convierte un texto a minúsculas.",
      "parameters": [
        { "name": "value", "type": "String", "required": true }
      ],
      "returns": { "type": "String", "nullable": false, "readOnly": true },
      "signatures": ["lower(value: String): String"],
      "examples": ["lower(\"HOLA\")"]
    },
    "length": {
      "kind": "query",
      "description": "Obtiene la cantidad de caracteres de un texto o de elementos de una lista.",
      "parameters": [
        { "name": "value", "type": "String | Array<Any>", "required": true }
      ],
      "returns": { "type": "Number", "nullable": false, "readOnly": true },
      "signatures": ["length(value: String | Array<Any>): Number"],
      "examples": ["length(\"Serez\")"]
    },
    "string": {
      "kind": "query",
      "description": "Convierte un texto, número o booleano a texto.",
      "parameters": [
        { "name": "value", "type": "String | Number | Boolean", "required": true }
      ],
      "returns": { "type": "String", "nullable": false, "readOnly": true },
      "signatures": ["string(value: String | Number | Boolean): String"],
      "examples": ["\"Somos \" + string(memberCount())"]
    },
    "int": {
      "kind": "query",
      "description": "Convierte un número o un texto entero a número entero. Los decimales se truncan hacia cero; un texto como \"10.5\" o \"abc\" produce un error.",
      "parameters": [
        { "name": "value", "type": "Number | String", "required": true }
      ],
      "returns": { "type": "Number", "nullable": false, "readOnly": true },
      "signatures": ["int(value: Number | String): Number"],
      "examples": ["int(\"10\")"]
    },
    "decimal": {
      "kind": "query",
      "description": "Convierte un número o un texto decimal (por ejemplo \"10.5\") a número. Un texto inválido produce un error.",
      "parameters": [
        { "name": "value", "type": "Number | String", "required": true }
      ],
      "returns": { "type": "Number", "nullable": false, "readOnly": true },
      "signatures": ["decimal(value: Number | String): Number"],
      "examples": ["decimal(\"10.5\")"]
    },
    "bool": {
      "kind": "query",
      "description": "Convierte un booleano o el texto exacto \"true\" o \"false\" a booleano. Cualquier otro texto produce un error.",
      "parameters": [
        { "name": "value", "type": "Boolean | String", "required": true }
      ],
      "returns": { "type": "Boolean", "nullable": false, "readOnly": true },
      "signatures": ["bool(value: Boolean | String): Boolean"],
      "examples": ["bool(\"true\")"]
    },
    "HasRole": {
      "kind": "query",
      "description": "Indica si un miembro contiene la referencia de rol indicada.",
      "parameters": [
        { "name": "member", "type": "Member", "required": true },
        { "name": "role", "type": "RoleReference", "required": true }
      ],
      "returns": { "type": "Boolean", "nullable": false, "readOnly": true },
      "signatures": ["HasRole(member: Member, role: RoleReference): Boolean"],
      "examples": ["HasRole(member, Role(\"371826690424569866\"))"]
    },
    "AddRole": {
      "kind": "action",
      "description": "Solicita agregar un rol a un miembro.",
      "parameters": [
        { "name": "member", "type": "Member", "required": true },
        { "name": "role", "type": "RoleReference", "required": true }
      ],
      "returns": { "type": "Void", "nullable": false, "readOnly": false },
      "signatures": ["AddRole(member: Member, role: RoleReference): Void"],
      "examples": ["AddRole(member, Role(\"371826690424569866\"))"]
    },
    "SendMessage": {
      "kind": "action",
      "description": "Envía un mensaje al canal indicado o al canal actual cuando channel se omite.",
      "parameters": [
        { "name": "config", "type": "SendMessageConfig", "required": true }
      ],
      "returns": { "type": "Void", "nullable": false, "readOnly": false },
      "signatures": ["SendMessage(config: SendMessageConfig): Void"],
      "examples": [
        "SendMessage({ message: \"Hola\" })",
        "SendMessage({ channel: Channel(\"123456789012345678\"), message: \"Hola\" })"
      ]
    },
    "ReplyMessage": {
      "kind": "action",
      "description": "Responde con texto al mensaje que originó el comando.",
      "parameters": [
        { "name": "config", "type": "ReplyMessageConfig", "required": true }
      ],
      "returns": { "type": "Void", "nullable": false, "readOnly": false },
      "signatures": ["ReplyMessage(config: ReplyMessageConfig): Void"],
      "examples": ["ReplyMessage({ message: \"Rol agregado\" })"]
    },
    "SendEmbed": {
      "kind": "action",
      "description": "Envía un embed al canal indicado o al canal actual cuando channel se omite.",
      "parameters": [
        { "name": "config", "type": "SendEmbedConfig", "required": true }
      ],
      "returns": { "type": "Void", "nullable": false, "readOnly": false },
      "signatures": ["SendEmbed(config: SendEmbedConfig): Void"],
      "examples": [
        "SendEmbed({ description: \"Información\" })",
        "SendEmbed({ image: \"https://example.com/banner.png\" })",
        "SendEmbed({ channel: Channel(\"123456789012345678\"), message: \"Aviso\", title: \"Novedad\", image: \"https://example.com/banner.png\" })"
      ]
    },
    "ReplyEmbed": {
      "kind": "action",
      "description": "Responde al mensaje de origen con un embed.",
      "parameters": [
        { "name": "config", "type": "ReplyEmbedConfig", "required": true }
      ],
      "returns": { "type": "Void", "nullable": false, "readOnly": false },
      "signatures": ["ReplyEmbed(config: ReplyEmbedConfig): Void"],
      "examples": [
        "ReplyEmbed({ description: \"Contenido de la respuesta\" })",
        "ReplyEmbed({ image: \"https://example.com/banner.png\" })"
      ]
    }
  }
}
